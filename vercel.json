{
  "version": 2,
  "builds": [
    { "src": "api/assistant.py", "use": "@vercel/python" },
    { "src": "*.html", "use": "@vercel/static" },
    { "src": "*.css", "use": "@vercel/static" },
    { "src": "*.png", "use": "@vercel/static" },
    { "src": "Fonts/**", "use": "@vercel/static" }
  ],
  "routes": [
    {
      "src": "/api/assistant/status",
      "methods": ["GET"],
      "dest": "api/assistant.py"
    },
    {
      "src": "/api/assistant",
      "methods": ["POST", "OPTIONS"],
      "dest": "api/assistant.py"
    },
    {
      "src": "/api/upload",
      "methods": ["POST", "OPTIONS"],
      "dest": "api/assistant.py"
    },
    { "src": "/(.*)", "dest": "/$1" }
  ]
}
